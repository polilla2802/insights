// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "cockroachdb"
  url      = env("DATABASE_URL")
}

model Alcaldia {
  id           String        @id @default(cuid())
  nombre       String
  slug         String        @unique
  descripcion  String?
  imagen       String?
  lat          Float?
  lng          Float?
  poligono     Json?
  experiencias Experiencia[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model Categoria {
  id           String        @id @default(cuid())
  nombre       String
  slug         String        @unique
  icono        String?
  experiencias Experiencia[]
}

model Experiencia {
  id          String          @id @default(cuid())
  titulo      String
  descripcion String
  precio      Float
  duracion    Int
  imagen      String?
  imagenes    String[]
  tipo        TipoExperiencia
  lugar       String?
  direccion   String?
  rating      Float           @default(0)
  numResenas  Int             @default(0)
  destacada   Boolean         @default(false)
  activa      Boolean         @default(true)
  alcaldiaId  String
  alcaldia    Alcaldia        @relation(fields: [alcaldiaId], references: [id])
  categoriaId String
  categoria   Categoria       @relation(fields: [categoriaId], references: [id])
  reservas    Reserva[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

enum TipoExperiencia {
  RESTAURANTE
  MUSEO
  EVENTO
  TOUR
  ACTIVIDAD
}

model Usuario {
  id        String    @id @default(cuid())
  nombre    String
  email     String    @unique
  foto      String?
  rol       Rol       @default(VISITANTE)
  reservas  Reserva[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

enum Rol {
  VISITANTE
  HOST
  ADMIN
}

model Reserva {
  id            String        @id @default(cuid())
  personas      Int           @default(1)
  fecha         DateTime
  total         Float
  estado        EstadoReserva @default(PENDIENTE)
  experienciaId String
  experiencia   Experiencia   @relation(fields: [experienciaId], references: [id])
  usuarioId     String
  usuario       Usuario       @relation(fields: [usuarioId], references: [id])
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

enum EstadoReserva {
  PENDIENTE
  CONFIRMADA
  CANCELADA
  COMPLETADA
}

// ── Pasarela de Ads Enterprise ──────────────────────────────────────────────

model Empresa {
  id          String     @id @default(cuid())
  nombre      String
  logo        String?
  sitio       String?
  descripcion String?
  tier        TierEmpresa @default(STANDARD)
  campanas    Campana[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

enum TierEmpresa {
  STANDARD   // hasta $50k MXN/mes
  PREMIUM    // hasta $200k MXN/mes
  ENTERPRISE // presupuesto abierto
}

model Campana {
  id            String       @id @default(cuid())
  nombre        String
  presupuesto   Float
  fechaInicio   DateTime
  fechaFin      DateTime
  alcaldiaIds   String[]
  estado        EstadoCampana @default(ACTIVA)
  empresaId     String
  empresa       Empresa      @relation(fields: [empresaId], references: [id])
  anuncios      Anuncio[]
  impresiones   Int          @default(0)
  clics         Int          @default(0)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}

enum EstadoCampana {
  BORRADOR
  ACTIVA
  PAUSADA
  FINALIZADA
}

model Anuncio {
  id          String      @id @default(cuid())
  tipo        TipoAnuncio
  titulo      String
  descripcion String?
  imagen      String?
  ctaLabel    String      @default("Conocer más")
  ctaUrl      String
  alcaldiaIds String[]
  activo      Boolean     @default(true)
  campanaId   String
  campana     Campana     @relation(fields: [campanaId], references: [id])
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

enum TipoAnuncio {
  BANNER    // franja hero en landing
  CARD      // tarjeta patrocinada en el grid de experiencias
  STRIP     // banda horizontal entre secciones
}
